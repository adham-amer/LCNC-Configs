<?xml version='1.0' encoding='UTF-8'?>
<pyvcp>
         <vbox>
         <relief>RIDGE</relief>         
         <bd>6</bd>
                <label>
                        <text>"Spindle Speed:"</text>
                        <font>("Helvetica",20)</font>
                </label>
                <bar>
                        <halpin>"spindle-speed"</halpin>
                        <max_>3000</max_>
                </bar>
                <label>
                        <text>"Spindle-At-Speed:"</text>
                        <font>("Helvetica",20)</font>
                </label>
                <hbox>
                    <label>
                            <text>"             "</text>
                            <font>("Helvetica",20)</font>
                    </label>
                    <led>
                        <halpin>"spindle-at-speed-led"</halpin> 
                        <size>30</size> 
                        <on_color>"green"</on_color>
                        <off_color>"red"</off_color>
                    </led>
                </hbox>


                <!-- the RPM meter -->
                <hbox>
                        <relief>RAISED</relief>
                        <bd>3</bd>
                        <meter>
                        <halpin>"spindle_rpm"</halpin>
                        <text>"Spindle"</text>
                        <subtext>"RPM"</subtext>
                        <size>200</size>
                        <min_>0</min_>
                        <max_>3000</max_>
                        <majorscale>500</majorscale>
                        <minorscale>100</minorscale>
                        <region1>0,10,"yellow"</region1>
                        </meter>
                </hbox>

                <!-- the On Led -->
                <hbox>
                <relief>RAISED</relief>
                <bd>3</bd>
                <vbox>
                        <relief>RAISED</relief>
                        <bd>2</bd>
                        <label>
                                <text>"On"</text>
                                <font>("Helvetica",18)</font>
                        </label>
                        <width>5</width>
                        <hbox>
                                <label width="2"/> <!-- used to center the led -->
                                <rectled>
                                <halpin>"on-led"</halpin>
                                <height>"30"</height>
                                <width>"30"</width>
                                <on_color>"green"</on_color>
                                <off_color>"red"</off_color>
                                </rectled>
                        </hbox>
                </vbox>

        </vbox>
</pyvcp>
