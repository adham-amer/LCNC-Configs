<?xml version='1.0' encoding='UTF-8'?>
<pyvcp>
         <vbox>
         <relief>RIDGE</relief>         
         <bd>6</bd>
                <label>
                        <text>"Spindle Speed:"</text>
                        <font>("Helvetica",20)</font>
                </label>
                <bar>
                        <halpin>"spindle-speed"</halpin>
                        <max_>3000</max_>
                </bar>
                <label>
                        <text>"Spindle-At-Speed:"</text>
                        <font>("Helvetica",20)</font>
                </label>
                <hbox>
                    <label>
                            <text>"             "</text>
                            <font>("Helvetica",20)</font>
                    </label>
                    <led>
                        <halpin>"spindle-at-speed-led"</halpin> 
                        <size>30</size> 
                        <on_color>"green"</on_color>
                        <off_color>"red"</off_color>
                    </led>
                </hbox>


                <!-- the RPM meter -->
                <hbox>
                        <relief>RAISED</relief>
                        <bd>3</bd>
                        <meter>
                        <halpin>"spindle_rpm"</halpin>
                        <text>"Spindle"</text>
                        <subtext>"RPM"</subtext>
                        <size>200</size>
                        <min_>0</min_>
                        <max_>2500</max_>
                        <majorscale>500</majorscale>
                        <minorscale>100</minorscale>
                        <region1>0,800,"green"</region1>
                        <region2>800,1500,"yellow"</region2>
                        <region3>1500,2500,"red"</region3>
                        </meter>
                </hbox>

                <!-- the spindle angle dial -->
                <hbox>
                        <relief>RAISED</relief>
                        <bd>3</bd>
                        <meter>
                        <halpin>"spindle_angle"</halpin>
                        <text>"Spindle"</text>
                        <subtext>"Angle Deg"</subtext>
                        <size>200</size>
                        <min_>0</min_>
                        <max_>360</max_>
                        <majorscale>45</majorscale>
                        <minorscale>5</minorscale>
                        <region1>0,90,"green"</region1>
                        <region2>90,270,"yellow"</region2>
                        <region3>270,360,"green"</region3>
                        </meter>
                </hbox>

        </vbox>
</pyvcp>
